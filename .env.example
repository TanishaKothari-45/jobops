# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- LLM providers (only one is needed to start) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Which model the agent runs as
JOBOPS_MODEL=claude-sonnet-5

# --- Storage (real backend, later) ---
DATABASE_URL=postgresql://localhost:5432/jobops
REDIS_URL=redis://localhost:6379/0

# --- OAuth for real connectors (later) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
